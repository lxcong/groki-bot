# Groki Bot gateway settings.
# Copy to `.env` in this directory and fill in the values you need.
# Everything except GEMINI_API_KEY is optional.

# --- Voice (required for talking) ---
# Google AI Studio API key used for Gemini Live voice conversation.
# Get one at https://aistudio.google.com/apikey . Never commit it.
GEMINI_API_KEY=

# Gemini Live voice name (Kore, Puck, Charon, Leda, ...).
STACKCHAN_GEMINI_VOICE=Kore

# Gemini Live model. Default gemini-3.8-live; set gemini-3.1-flash-live-preview
# to go back. 2.x Live models allow true TEXT output.
# STACKCHAN_GEMINI_MODEL=gemini-3.8-live

# --- Robot connection ---
# Shared secret between the robot and this gateway. Strongly recommended on
# any network you do not fully control. Generate one with `openssl rand -hex 16`
# and paste the same value into the robot's "XiaoZhi token" setting.
# Leave empty to accept any device on your network.
STACKCHAN_TOKEN=

# WebSocket server the robot connects to: ws://<this computer's LAN IP>:8765
HOST=0.0.0.0
WS_PORT=8765

# HTTP server for photo upload and the status page (http://127.0.0.1:8766/debug/status).
CAPTURE_PORT=8766

# LAN IP of this computer as seen from the robot, for example 192.168.x.y.
# Only needed for photo capture on firmware that supports it.
VISION_HOST=
# Full public capture URL, for tunnel setups (example: https://robot.example.ts.net:8443/capture).
VISION_URL=
# Separate bearer token for photo uploads. Empty reuses STACKCHAN_TOKEN.
VISION_TOKEN=

# --- Wake word ("Hi Grok") ---
# Needs the `wakeword` extra and the model download described in README.md.
# Without the model the gateway passes all microphone audio through.
# STACKCHAN_WAKE_WORD=0 turns the wake word gate off.
# STACKCHAN_WAKE_PHRASE=hey groki switches to "Hey Groki" instead. For your
# own phrase set STACKCHAN_WAKE_PHRASE and STACKCHAN_WAKE_KEYWORD, see
# "Changing the wake word" in README.md.
STACKCHAN_KWS_SCORE=7
STACKCHAN_KWS_THRESHOLD=0.05
# Custom model location (defaults to ./models/kws).
# STACKCHAN_KWS_MODEL_DIR=

# --- Face tracking (Mac with a camera) ---
# The gateway starts tools/vision-tracker when it starts and the head follows
# faces. Build the tracker first: cd tools/vision-tracker && swift build -c release
# Set 0 on a computer without a camera: the tracker is not started.
STACKCHAN_FACE_TRACKER_AUTOSTART=1
# Tracker executable. Default: tools/vision-tracker/.build/release/groki-vision-tracker
# STACKCHAN_FACE_TRACKER_BIN=
# Part of the camera name to use (case-insensitive). Empty: Studio Display,
# then iPhone, then the first camera found.
# STACKCHAN_FACE_TRACKER_CAMERA=
# Set 0 to start with head follow off (no head servos, or keep the head still);
# "look at me" turns it on.
STACKCHAN_HEAD_FOLLOW_DEFAULT=1

# --- Optional features (off by default) ---
# Let voice commands control this Mac: open apps and URLs, media keys, volume,
# screenshots, Shortcuts, and background `claude -p` tasks that can edit files.
# STACKCHAN_MAC_CONTROL=1

# Give Gemini the face / LED / head tools (set_avatar, set_all_leds, move_head,
# express_emotion) and the upstream xiaozhi-esp32 firmware tools (get_device_status,
# set_device_volume, set_screen_brightness, set_screen_theme, start_game, stop_game;
# a device that does not offer one answers "not offered by device"). With the
# Groki Bot firmware (no device MCP) the gateway sends faces / LEDs / head as
# XiaoZhi messages instead: faces as emotions, LED colours as "led", head moves
# as "head" (turning the head needs firmware with the head message, newer than v0.2.1).
# STACKCHAN_GEMINI_DEVICE_TOOLS=1

# Low-latency USB serial control channel. Holds /dev/cu.usbmodem* exclusively,
# which blocks flashing and serial monitors while the gateway runs.
# STACKCHAN_USB_TRANSPORT=1

# The ask_claude voice tool is offered only when the `claude` CLI is found.
# Set 0 to leave it out even when the CLI is installed.
# STACKCHAN_ASK_CLAUDE=0

# Absolute path to the `claude` CLI used by the ask_claude voice tool.
# Defaults to `claude` on PATH.
# STACKCHAN_CLAUDE_BIN=

# Model the Claude CLI uses for ask_claude and Mac tasks.
# STACKCHAN_CLAUDE_MODEL=claude-sonnet-5

# Extra persona text appended to Gemini's instructions. Defaults to
# personality.md in this directory when that file exists. The built-in
# persona (named Groki, replies in the user's language) gives way to this
# text wherever they differ.
# STACKCHAN_PERSONALITY_FILE=

# Name the Grok voice call speaks as (default Groki). personality.md above is
# also sent to Grok as the call description, so the persona applies there too.
# STACKCHAN_GBOT_VOICE_AGENT_NAME=
# STACKCHAN_GBOT_VOICE_USER_NAME=

# --- Grok Bot hand-off (optional, off by default) ---
# Lets the robot hand tasks ("look this up", "research X") to an agent in the
# Grok Bot app and read the agent's replies aloud. Needs, on this computer:
# the Grok Bot app signed in, the gbot CLI (npm install --global grok-bot-cli),
# and the forwarding service running: `uv run stackchan-gbot-proxy`.
# Details: docs/architecture.md in the repository root.
#
# Name of the Grok Bot agent (or group) that receives tasks, as shown by
# `gbot bots list`. Setting it turns the feature on.
# STACKCHAN_TOOL_BOT=
# Optional agent id, sent next to the name.
# STACKCHAN_TOOL_BOT_ID=
# Text put in front of every task so the agent answers in a form that works
# when read aloud. Leave it commented out for the built-in default; set it to
# an empty value to send tasks as they are.
# STACKCHAN_TOOL_BOT_PREFIX=
# Forwarding service address, and how long to wait for replies (seconds).
# STACKCHAN_GBOT_URL=http://127.0.0.1:18770
# STACKCHAN_ASK_TIMEOUT=110
# Read by the forwarding service: gbot location when it is not on PATH, and
# its port. The service always binds 127.0.0.1.
# STACKCHAN_GBOT_BIN=
# STACKCHAN_GBOT_HTTP_PORT=18770
